
<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui">
    <ui:style>
        .container { padding: 30px; }
        .form-row { margin-bottom: 15px; }
        .label { display: block; font-weight: bold; margin-bottom: 5px; }
    </ui:style>
    <g:HTMLPanel styleName="{style.container}">
        <h1>ElevateHR: Vacancy Registration (GWT)</h1>
        <div class="{style.form-row}">
            <g:Label styleName="{style.label}">Job Title:</g:Label>
            <g:TextBox ui:field="titleBox" width="300px" />
        </div>
        <div class="{style.form-row}">
            <g:Label styleName="{style.label}">Company:</g:Label>
            <g:TextBox ui:field="companyBox" width="300px" />
        </div>
        <div class="{style.form-row}">
            <g:Label styleName="{style.label}">Description:</g:Label>
            <g:TextArea ui:field="descriptionArea" width="300px" height="100px" />
        </div>
        <g:Button ui:field="submitButton" text="Register Vacancy" />
        <hr />
        <g:VerticalPanel ui:field="listPanel" />
    </g:HTMLPanel>
</ui:UiBinder>
